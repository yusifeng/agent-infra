FROM node:22-bookworm-slim

WORKDIR /opt/agent-runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

RUN npm init -y \
  && npm install @openai/codex-sdk@0.142.0 @openai/codex@0.142.0 \
  && npm cache clean --force

COPY codex-agent-runner.mjs /opt/agent-runtime/codex-agent-runner.mjs

CMD ["node", "/opt/agent-runtime/codex-agent-runner.mjs"]
