FROM node:22-bookworm-slim

WORKDIR /opt/agent-runtime

RUN npm init -y \
  && npm install @anthropic-ai/claude-agent-sdk@0.3.185 @anthropic-ai/sdk@0.93.0 \
  && npm cache clean --force

COPY claude-agent-runner.mjs /opt/agent-runtime/claude-agent-runner.mjs

CMD ["node", "/opt/agent-runtime/claude-agent-runner.mjs"]
