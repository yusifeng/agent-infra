{
  "name": "agent-infra",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "audit:theme:vite": "node scripts/audit-vite-theme-usage.mjs",
    "check:colors:next": "node scripts/check-color-convergence.mjs apps/playground-next-web --allow-file apps/playground-next-web/app/globals.css --allow-file apps/playground-next-web/components/chat-shell/durable-log-pane.tsx --allow-file apps/playground-next-web/app/site-icons/[hostname]/route.ts",
    "check:colors:vite": "node scripts/check-color-convergence.mjs apps/playground-vite-web/src --allow-file apps/playground-vite-web/src/theme.css --allow-file apps/playground-vite-web/src/features/durable-chat/components/chat-shell.css",
    "dev": "pnpm --filter playground-next-web dev:prepared",
    "dev:next-web": "pnpm --filter playground-next-web dev:prepared",
    "dev:vite-web": "pnpm --filter playground-vite-web dev",
    "dev:fastify-server": "pnpm --filter playground-fastify-server dev:prepared",
    "dev:fastify-server:sqlite": "pnpm --filter playground-fastify-server dev:prepared:sqlite",
    "dev:fastify-server:turso": "pnpm --filter playground-fastify-server dev:prepared:turso",
    "dev:docs": "pnpm --filter docs-web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @agent-infra/core build && pnpm --filter @agent-infra/contracts build && pnpm --filter @agent-infra/durable-chat-client build && pnpm --filter @agent-infra/db build && pnpm --filter @agent-infra/app build && pnpm --filter @agent-infra/durable-chat-server build && pnpm --filter @agent-infra/runtime-pi build && pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.5",
    "typescript": "^5.8.3"
  }
}
