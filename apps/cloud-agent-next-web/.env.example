# Temporary local admin login for the cloud-agent Next.js app.
CLOUD_AGENT_ADMIN_PASSWORD=123456
CLOUD_AGENT_ADMIN_SESSION_TOKEN=change-me-for-shared-environments

# Local SQLite/workspace/provider-config data root. Leave empty to use
# apps/cloud-agent-next-web/.cloud-agent-data.
# CLOUD_AGENT_DATA_DIR=/absolute/path/to/cloud-agent-data
# CLOUD_AGENT_SQLITE_PATH=/absolute/path/to/cloud-agent.db

# Run queue provider. Default in-process starts execution from the request for
# local convenience. Set db-queue to make routes only create durable runs and
# attach/follow events; run a separate DB-backed worker with:
# pnpm --filter cloud-agent-next-web worker:loop
# Set bullmq to enqueue Redis jobs; run a separate BullMQ worker with:
# pnpm --filter cloud-agent-next-web worker:bullmq
# Supported now: in-process, db-poll, db-queue, bullmq. Temporal is planned and
# fails fast until implemented.
# CLOUD_AGENT_RUN_QUEUE_PROVIDER=db-queue
# REDIS_URL=redis://127.0.0.1:6379
# CLOUD_AGENT_BULLMQ_QUEUE_NAME=cloud-agent-runs
# Backward-compatible alias:
# CLOUD_AGENT_RUN_DISPATCH=external
# CLOUD_AGENT_WORKER_CONCURRENCY=1
# CLOUD_AGENT_WORKER_LEASE_MS=300000
# CLOUD_AGENT_WORKER_POLL_MS=1000
# CLOUD_AGENT_WORKER_MAX_ATTEMPTS=3
# CLOUD_AGENT_WORKER_RETRY_BASE_MS=5000
# CLOUD_AGENT_WORKER_MAX_IDLE_MS=

# Secret broker provider. Supported now: env. Planned providers fail fast until
# implemented: vault, kms, proxy, file-materializer.
# CLOUD_AGENT_SECRET_BROKER_PROVIDER=env
# Workspace secret refs using refKey=env:NAME are fail-closed unless NAME is
# allowlisted here.
# CLOUD_AGENT_SECRET_ENV_ALLOWLIST=ANTHROPIC_API_KEY,ANTHROPIC_AUTH_TOKEN,OPENAI_API_KEY
# Add file when a tool/MCP expects a credential file path. Add proxy when a
# sandbox should receive a scoped short-lived proxy token instead of a raw
# secret value. File secrets are materialized under the per-user credentials
# dir and mounted read-only at /agent-credentials for Docker execution.
# CLOUD_AGENT_SECRET_DELIVERY_ALLOWLIST=env,file,proxy
# CLOUD_AGENT_SECRET_TTL_MS=300000
# Required only when delivery=proxy is allowlisted and used.
# CLOUD_AGENT_SECRET_PROXY_SIGNING_KEY=
# URL injected into sandbox env as CLOUD_AGENT_SECRET_PROXY_URL when any active
# workspace secret uses delivery=proxy. For local Docker, host.docker.internal
# reaches the Next.js dev server on the host.
# CLOUD_AGENT_SECRET_PROXY_URL=http://host.docker.internal:3011/api/runtime/secrets/proxy-exchange
# delivery=proxy tokens can be exchanged by sandboxed tools through:
# POST /api/runtime/secrets/proxy-exchange { "token": "..." }
# The route validates token signature/expiry and rechecks allowlists before
# returning the scoped secret value. Keep it reachable only from trusted worker
# or sandbox networking.

# Optional remote MCP egress policy. When set, HTTP/SSE MCP servers from
# AgentProfile are skipped unless their URL hostname appears in this comma-
# separated list. Skipped/enabled decisions are recorded in mcp_profile_audit
# run events. HTTP/SSE MCP profile entries may also include toolAllowlist,
# which is compiled to the SDK's per-server remote MCP tools policy.
# CLOUD_AGENT_MCP_REMOTE_HOST_ALLOWLIST=mcp.internal.example.com,docs.internal.example.com
# Remote MCP requires HTTPS by default. Set this only for explicitly trusted
# local/internal HTTP MCP endpoints.
# CLOUD_AGENT_MCP_ALLOW_INSECURE_HTTP=false
# Inline MCP headers are skipped by default so Authorization-style raw secrets
# do not live in AgentProfile metadata. Prefer secret refs/proxy delivery.
# CLOUD_AGENT_MCP_ALLOW_INLINE_HEADERS=false
# Optional stdio MCP command policy. When set, Docker stdio MCP servers are
# skipped unless their command appears here.
# CLOUD_AGENT_MCP_STDIO_COMMAND_ALLOWLIST=node,python
# Optional skill ref policy. When set, AgentProfile skillRefs are skipped unless
# they appear in this comma-separated list. This is a minimal policy gate, not a
# full skill package signature system. Enabled skill refs are also written to a
# per-run CLOUD_AGENT_SKILLS_MANIFEST under the read-only credentials mount so
# sandboxed tools can inspect the materialization plan.
# CLOUD_AGENT_SKILL_REF_ALLOWLIST=repo-review,docs-search

# Claude Code / Anthropic provider configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# DeepSeek Claude Code compatibility.
# If ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic, runtime will map
# ANTHROPIC_API_KEY to ANTHROPIC_AUTH_TOKEN automatically. You may also set
# ANTHROPIC_AUTH_TOKEN directly.
# ANTHROPIC_AUTH_TOKEN=
# Defaults are intentionally cheap for smoke testing. DeepSeek's Claude Code
# docs recommend deepseek-v4-pro[1m] for the main model and max effort; override
# manually when you want that behavior.
# ANTHROPIC_MODEL=deepseek-v4-flash
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
# CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
# CLAUDE_CODE_EFFORT_LEVEL=
# CLAUDE_AGENT_PERMISSION_MODE=default
# Web chat default timeout. Package smoke keeps its own 5s default unless
# CLAUDE_AGENT_TIMEOUT_MS is explicitly set.
# CLOUD_AGENT_WEB_CLAUDE_TIMEOUT_MS=120000
# CLAUDE_AGENT_TIMEOUT_MS=5000

# Claude SDK execution plane. The default is docker so tool calls see
# /workspace instead of the host filesystem path.
# Build the local image with:
# docker build -f packages/cloud-agent-runtime/docker/Dockerfile.claude-agent \
#   -t agent-infra/claude-agent-runtime:local packages/cloud-agent-runtime/docker
# CLOUD_AGENT_CLAUDE_EXECUTION=docker
# CLOUD_AGENT_CLAUDE_DOCKER_IMAGE=agent-infra/claude-agent-runtime:local
# CLOUD_AGENT_CLAUDE_EXECUTION=local is an unsandboxed development escape hatch
# and will expose host paths to the SDK/tools. Do not use it for the sandbox
# runtime path.
