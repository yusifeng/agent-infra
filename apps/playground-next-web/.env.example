# playground-next-web is the durable runtime console reference consumer.

# runtime-pi server route configuration:
# If both are present, runtime-pi defaults to DeepSeek and exposes both model families in the UI.
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# TAVILY_API_KEY=tvly-...
# PLAYGROUND_DUAL_ANSWER_ENABLED=false

# db configuration:
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=...
# DATABASE_URL=postgres://...
# SQLITE_PATH=./local.db

# playground host auth:
# AUTH_CODE_SECRET=replace-with-a-long-random-secret
# AUTH_ALLOWED_ORIGINS=http://localhost:3000,https://your-preview.vercel.app,https://your-domain.example
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM="Playground <noreply@example.com>"

# deployment smoke auth:
# PLAYGROUND_NEXT_WEB_SMOKE_EMAIL=smoke@example.com
# PLAYGROUND_NEXT_WEB_SMOKE_PASSWORD=replace-with-smoke-user-password
