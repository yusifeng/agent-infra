{
  "name": "playground-next-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:db": "tsx ./scripts/bootstrap-db.ts",
    "build:deps": "pnpm --filter @agent-infra/core build && pnpm --filter @agent-infra/contracts build && pnpm --filter @agent-infra/durable-chat-client build && pnpm --filter @agent-infra/db build && pnpm --filter @agent-infra/app build && pnpm --filter @agent-infra/durable-chat-server build && pnpm --filter @agent-infra/runtime-pi build",
    "prebuild": "pnpm build:deps",
    "predev": "pnpm build:deps",
    "pretypecheck": "pnpm build:deps",
    "dev": "node ./scripts/run-next-with-playground-env.mjs dev",
    "dev:prepared": "NODE_ENV=development pnpm bootstrap:db && NODE_ENV=development pnpm dev",
    "dev:prepared:sqlite": "PLAYGROUND_DB_MODE=sqlite NODE_ENV=development pnpm bootstrap:db && exec env PLAYGROUND_DB_MODE=sqlite NODE_ENV=development pnpm dev",
    "dev:prepared:turso": "PLAYGROUND_DB_MODE=turso NODE_ENV=development pnpm bootstrap:db && exec env PLAYGROUND_DB_MODE=turso NODE_ENV=development pnpm dev",
    "deploy:production": "node ./scripts/deploy-production.mjs",
    "build": "node ./scripts/run-next-with-playground-env.mjs build",
    "smoke:deployment": "node ./scripts/deployment-smoke.mjs",
    "start": "node ./scripts/run-next-with-playground-env.mjs start",
    "start:prepared": "NODE_ENV=production pnpm bootstrap:db && NODE_ENV=production pnpm start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-infra/app": "workspace:*",
    "@agent-infra/contracts": "workspace:*",
    "@agent-infra/core": "workspace:*",
    "@agent-infra/db": "workspace:*",
    "@agent-infra/durable-chat-client": "workspace:*",
    "@agent-infra/durable-chat-server": "workspace:*",
    "@agent-infra/runtime-pi": "workspace:*",
    "@fontsource-variable/geist": "^5.2.8",
    "@mariozechner/pi-agent-core": "^0.66.1",
    "@mariozechner/pi-ai": "^0.66.1",
    "@radix-ui/react-select": "^2.2.6",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "0.548.0",
    "marked": "^18.0.0",
    "next": "16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.12.3",
    "shadcn": "^4.3.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
