{
  "name": "playground-next-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:db": "node ./scripts/bootstrap-db.mjs",
    "dev": "next dev",
    "dev:prepared": "NODE_ENV=development pnpm bootstrap:db && NODE_ENV=development pnpm dev",
    "build": "next build",
    "smoke:deployment": "node ./scripts/deployment-smoke.mjs",
    "start": "next start",
    "start:prepared": "NODE_ENV=production pnpm bootstrap:db && NODE_ENV=production pnpm start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-infra/app": "workspace:*",
    "@agent-infra/contracts": "workspace:*",
    "@agent-infra/core": "workspace:*",
    "@agent-infra/db": "workspace:*",
    "@agent-infra/durable-chat-client": "workspace:*",
    "@agent-infra/durable-chat-server": "workspace:*",
    "@agent-infra/runtime-pi": "workspace:*",
    "@mariozechner/pi-agent-core": "^0.66.1",
    "@mariozechner/pi-ai": "^0.66.1",
    "@radix-ui/react-select": "^2.2.6",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "lucide-react": "0.548.0",
    "marked": "^18.0.0",
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
